# Copy to .env and fill in.
#
# Local PostgreSQL over the unix socket (no password, peer auth):
#   DATABASE_URL="postgresql://<youruser>@localhost/solinal_gestiona?host=/var/run/postgresql"
# Or, with the bundled docker-compose Postgres:
#   DATABASE_URL="postgresql://solinal:solinal@localhost:5432/solinal_gestiona?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/solinal_gestiona?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/solinal_gestiona_test?schema=public"

PORT=3001
NODE_ENV=development

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

CORS_ORIGIN="http://localhost:5173"

MAX_FAILED_LOGIN_ATTEMPTS=3
